{
  "name": "opencode-fusion",
  "version": "0.1.0",
  "type": "module",
  "description": "Devin-Fusion-style lead + sidekick model pairing for OpenCode V2, with a TUI picker.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xZ0uk/opencode-fusion.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.0.19",
    "@opencode/theme": "2.0.19",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "^22.10.2",
    "solid-js": "1.9.12",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.19",
    "effect": "4.0.0-rc.112",
    "@opencode/schema": "2.0.19"
  }
}
