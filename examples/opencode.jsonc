{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/absolute/path/to/opencode-fusion/src/index.ts",
      "options": {
        "enforce": "full",
        "allowShell": [],
        "sidekickAutoApprove": true,
        "blockTimeoutSeconds": 1800
      }
    }
  ]
}
