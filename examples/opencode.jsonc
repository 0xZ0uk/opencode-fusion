{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/absolute/path/to/opencode-fusion/src/index.ts",
      "options": {
        "enforce": "full",
        "allowShell": [],
        "sidekickAutoApprove": true
      }
    }
  ],
  "agents": {
    "fusion-lead": {
      "mode": "primary",
      "description": "Fusion lead: plans, decides, reviews, delegates the mechanical work"
    },
    "fusion-sidekick": {
      "mode": "subagent",
      "description": "Fusion sidekick: executes the lead's plan in its own persistent context"
    }
  }
}
